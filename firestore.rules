rules_version = '2';

// Todo el acceso a datos se hace desde el servidor con el Admin SDK, que
// ignora estas reglas. Ningún cliente (navegador) debe leer ni escribir
// directamente en Firestore: aquí se deniega todo el acceso de cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
