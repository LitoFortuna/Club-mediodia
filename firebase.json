{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/",
        "destination": "https://clubmediodia.es",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://clubmediodia.es/:path*",
        "type": 301
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "europe-west3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
